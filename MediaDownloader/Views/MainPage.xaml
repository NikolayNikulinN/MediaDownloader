<ui:FluentWindow x:Class="MediaDownloader.Views.MainPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:MediaDownloader.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel}"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ResizeMode="CanResize"
                 Title="{Binding ResourceWrapper.AppTitle}"
                 Height="800"
                 Width="1200"
                 StateChanged="WindowStateChanged">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="{Binding AppConstants.Images.AppIconPath}"
                           Width="30"
                           Height="30"
                           Stretch="Uniform" />
                    <TextBlock Text="{Binding ResourceWrapper.AppTitle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <Border Grid.ColumnSpan="2"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <ui:Button Style="{StaticResource TitleBarImageButtonStyle}"
                               Click="MinimizeButtonClick"
                               ToolTip="{Binding ResourceWrapper.MinimizeToolTip}">
                        <Image Source="{Binding AppConstants.Images.MinimizePath}"
                               Width="22"
                               Height="22"
                               Stretch="Uniform" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource TitleBarImageButtonStyle}"
                               Click="MaximizeRestoreButtonClick"
                               ToolTip="{Binding MaximizeRestoreToolTip}">
                        <Image Source="{Binding MaximizeRestoreIconPath}"
                               Width="22"
                               Height="22"
                               Stretch="Uniform" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource TitleBarImageButtonStyle}"
                               Click="CloseButtonClick"
                               ToolTip="{Binding ResourceWrapper.CloseToolTip}">
                        <Image Source="{Binding AppConstants.Images.ClosePath}"
                               Width="22"
                               Height="22"
                               Stretch="Uniform" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ContentControl Margin="24,16,24,16"
                                Content="{Binding ActivePage}" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="12,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding LibraryUpdateStatus}" />

                    <ui:Button Width="36"
                               Height="32"
                               Margin="0,0,8,0"
                               Padding="0"
                               Appearance="Secondary"
                               Cursor="Hand"
                               Command="{Binding CheckLibraryUpdatesCommand}"
                               ToolTip="{Binding ResourceWrapper.CheckLibrariesToolTip}">
                        <Image Width="50"
                               Height="50"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Source="{Binding AppConstants.Images.CheckLibsVersionPath}"
                               Stretch="Uniform" />
                    </ui:Button>

                    <ui:Button Width="36"
                               Height="32"
                               Padding="0"
                               Appearance="Secondary"
                               Cursor="Hand"
                               Command="{Binding OpenToolsFolderCommand}"
                               ToolTip="{Binding ResourceWrapper.OpenToolsFolderToolTip}">
                        <Image Width="24"
                               Height="22"
                               Source="{Binding AppConstants.Images.FolderPath}"
                               Stretch="Uniform" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <Border Grid.RowSpan="3"
                    Background="#01000000"
                    Cursor="Wait"
                    Panel.ZIndex="100"
                    Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</ui:FluentWindow>
