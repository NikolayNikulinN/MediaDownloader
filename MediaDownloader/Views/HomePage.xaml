<UserControl x:Class="MediaDownloader.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:MediaDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:HomePageViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Style="{StaticResource UrlTextBoxStyle}"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsUrlInputEnabled}"
                         ToolTip="{Binding ResourceWrapper.YouTubeUrlToolTip}" />

                <TextBlock Text="{Binding ResourceWrapper.UrlPlaceholder}"
                           Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsUrlPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <ui:Button Grid.Column="2"
                       Height="42"
                       Appearance="Primary"
                       Cursor="Hand"
                       Command="{Binding AddUrlCommand}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <ui:ProgressRing Width="16"
                                     Height="16"
                                     Margin="0,0,8,0"
                                     IsIndeterminate="{Binding IsAnalyzing}"
                                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ResourceWrapper.AnalyzeUrlButtonText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding AnalysisStatus}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="4" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ResourceWrapper.SaveToLabel}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />

            <TextBox Grid.Column="2"
                     Style="{StaticResource UrlTextBoxStyle}"
                     Height="36"
                     FontSize="13"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding ResourceWrapper.DownloadFolderToolTip}" />

            <ui:Button Grid.Column="4"
                       Height="36"
                       Content="{Binding ResourceWrapper.BrowseButtonText}"
                       Appearance="Secondary"
                       Cursor="Hand"
                       Command="{Binding BrowseOutputFolderCommand}" />

            <ui:Button Grid.Column="6"
                       Width="42"
                       Height="36"
                       Padding="0"
                       Appearance="Secondary"
                       Cursor="Hand"
                       ToolTip="{Binding ResourceWrapper.OpenFolderToolTip}"
                       Command="{Binding OpenOutputFolderCommand}">
                <Image Source="{Binding AppConstants.Images.FolderPath}"
                       Width="28"
                       Height="24"
                       Stretch="Uniform" />
            </ui:Button>
        </Grid>

        <Border Grid.Row="6"
                Padding="12"
                CornerRadius="10"
                Background="{DynamicResource MediaListPanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <TextBlock Text="{Binding ResourceWrapper.NoDataText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsNoDataVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListBox ItemsSource="{Binding UrlItems}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource MediaListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="96"
                                    Padding="10"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" MinWidth="250" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                            <Border Grid.Column="0"
                                    Width="104"
                                    Height="74"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE714;"
                                               FontSize="30"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Image Source="{Binding ThumbnailUrl}"
                                           Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,6,5"
                                            Padding="6,2"
                                            CornerRadius="4"
                                            Background="{DynamicResource DurationOverlayBrush}">
                                        <TextBlock Text="{Binding Duration}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DurationOverlayTextBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE77B;" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Author}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8D6;" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE787;" />
                                    <TextBlock Text="{Binding UploadDate}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid>
                                    <ItemsControl ItemsSource="{Binding AvailableVideoQualities}"
                                                  IsEnabled="{Binding CanChangeDownloadOptions}"
                                                  Visibility="{Binding AreVideoQualitiesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource FormatBadgeStyle}"
                                                             Content="{Binding Name}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             GroupName="{Binding DataContext.Url, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding DataContext.ResourceWrapper.DownloadBestQualityText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AreVideoQualitiesVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource MediaModeToggleStyle}"
                                              Content="{Binding DataContext.ResourceWrapper.Mp4Label, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              Tag="{Binding DataContext.ResourceWrapper.Mp3Label, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              IsChecked="{Binding IsAudioSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChangeDownloadOptions}"
                                              ToolTip="{Binding DataContext.ResourceWrapper.MediaModeToolTip, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <ui:Button Width="36"
                                           Height="36"
                                           Margin="10,0,0,0"
                                           Padding="0"
                                           Appearance="Secondary"
                                           ToolTip="{Binding DownloadButtonToolTip}"
                                           Command="{Binding DataContext.ToggleDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}"
                                           Cursor="Hand">
                                    <Image Width="24"
                                           Height="24"
                                           Source="{Binding DownloadButtonIconPath}"
                                           Stretch="Uniform" />
                                </ui:Button>
                                <ui:Button Width="36"
                                           Height="36"
                                           Margin="10,0,0,0"
                                           Padding="0"
                                           Appearance="Secondary"
                                           ToolTip="{Binding DataContext.ResourceWrapper.DeleteToolTip, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           IsEnabled="{Binding CanChangeDownloadOptions}"
                                           Command="{Binding DataContext.DeleteUrlItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}"
                                           Cursor="Hand">
                                    <Viewbox Width="22"
                                             Height="22"
                                             Stretch="Uniform">
                                        <Canvas Width="1024"
                                                Height="1536">
                                            <Path Fill="{DynamicResource DeleteButtonIconBrush}"
                                                  Data="M4220 13840 c-467 -36 -836 -261 -1010 -615 -90 -182 -123 -349 -136 -692 l-6 -183 -862 0 c-940 0 -913 1 -1013 -57 -206 -120 -242 -435 -70 -607 84 -83 147 -106 322 -115 l130 -6 2 -65 c2 -36 12 -198 23 -360 25 -369 57 -852 70 -1075 6 -93 15 -233 20 -310 6 -77 21 -311 35 -520 14 -209 27 -409 30 -445 3 -36 9 -135 15 -220 5 -85 14 -220 20 -300 12 -177 37 -553 50 -750 18 -269 50 -743 70 -1013 37 -498 50 -671 70 -962 26 -379 47 -666 65 -895 8 -102 21 -279 30 -395 49 -680 58 -766 97 -910 97 -366 341 -620 688 -716 l85 -24 2110 -3 c1480 -2 2135 1 2194 8 380 50 674 303 800 688 55 168 62 225 126 1107 8 116 22 300 30 410 32 433 172 2411 195 2755 6 85 17 254 25 375 8 121 24 357 35 525 11 168 27 397 35 510 14 187 38 552 65 965 6 88 19 286 30 440 11 154 27 386 35 515 9 129 22 325 30 435 8 110 15 207 15 216 0 14 19 17 128 21 157 7 217 27 297 99 97 89 148 237 125 361 -28 148 -144 270 -289 304 -44 11 -236 14 -913 14 l-858 0 0 139 c0 306 -38 530 -118 704 -104 224 -284 403 -513 511 -183 86 -320 119 -564 136 -161 11 -1602 11 -1745 0z m1785 -735 c205 -43 366 -195 409 -386 8 -35 17 -133 21 -216 l6 -153 -1315 0 -1316 0 0 124 c0 165 21 281 67 368 67 127 206 230 356 263 96 21 1673 21 1772 0z m1950 -1617 c-8 -115 -25 -368 -35 -543 -16 -267 -50 -830 -60 -995 -6 -85 -15 -227 -20 -315 -6 -88 -14 -232 -20 -320 -22 -353 -41 -667 -60 -995 -18 -310 -51 -832 -65 -1030 -3 -41 -14 -219 -25 -395 -11 -176 -29 -450 -40 -610 -11 -159 -29 -443 -40 -630 -11 -187 -27 -443 -35 -570 -9 -126 -27 -403 -40 -615 -55 -846 -57 -866 -107 -964 -27 -53 -110 -140 -165 -171 -24 -15 -70 -36 -101 -48 l-57 -22 -1927 -3 c-2096 -3 -1999 -5 -2124 52 -103 47 -204 169 -232 281 -17 66 -39 335 -77 950 -8 132 -30 476 -49 765 -62 916 -75 1124 -106 1610 -17 261 -37 574 -45 695 -8 121 -26 402 -40 625 -13 223 -27 439 -30 480 -3 41 -9 147 -15 235 -5 88 -19 297 -30 465 -11 168 -40 634 -65 1035 -24 402 -49 800 -55 885 -5 85 -10 170 -10 188 l0 32 2840 0 2841 0 -6 -72z M3605 10296 c-22 -7 -54 -20 -71 -29 -43 -22 -112 -100 -137 -155 l-22 -47 -3 -2600 c-2 -1913 0 -2618 8 -2667 21 -124 96 -212 217 -258 79 -30 205 -25 278 10 63 30 124 92 156 155 l24 50 0 2660 0 2660 -28 57 c-38 77 -103 133 -185 158 -73 23 -176 25 -237 6z M4993 10296 c-92 -30 -177 -108 -209 -194 -18 -45 -19 -168 -19 -2617 -1 -1413 2 -2608 5 -2655 11 -133 66 -220 177 -276 53 -27 66 -29 163 -29 98 1 109 3 166 32 69 36 126 94 157 161 l22 47 3 2635 c2 2933 8 2692 -68 2788 -28 36 -58 60 -106 83 -59 29 -78 34 -158 36 -57 2 -107 -2 -133 -11z M6399 10291 c-115 -37 -195 -123 -219 -236 -7 -35 -10 -856 -8 -2665 3 -2554 3 -2616 22 -2665 24 -62 108 -148 173 -176 66 -30 183 -36 255 -15 117 34 207 139 228 265 7 47 10 825 8 2666 l-3 2600 -33 67 c-44 90 -103 137 -207 164 -68 19 -149 17 -216 -5z">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="0.1" ScaleY="-0.1" />
                                                        <TranslateTransform Y="1536" />
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                </ui:Button>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding DownloadProgress}"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DownloadStatus}"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DownloadDate}"
                                           Margin="14,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
