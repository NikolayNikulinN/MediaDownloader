<UserControl x:Class="MediaDownloader.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:MediaDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:HomePageViewModel}">
    <UserControl.Resources>
        <Style x:Key="UrlTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="IconTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FormatBadgeStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="BadgeBorder"
                                MinWidth="{TemplateBinding MinWidth}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StaticFormatBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="MediaModeToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Knob"
                                        Grid.Column="0"
                                        CornerRadius="13"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />

                                <TextBlock x:Name="Mp4Text"
                                           Grid.Column="0"
                                           Text="MP4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock x:Name="Mp3Text"
                                           Grid.Column="1"
                                           Text="MP3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Grid.Column" Value="1" />
                                <Setter TargetName="Mp4Text" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter TargetName="Mp3Text" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource UrlTextBoxStyle}"
                     Text="https://www.youtube.com/watch?v=..."
                     ToolTip="YouTube URL" />

            <ui:Button Grid.Column="2"
                       Height="42"
                       Appearance="Primary"
                       Content="Analyze URL"
                       Cursor="Hand" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Save to"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />

            <TextBox Grid.Column="2"
                     Style="{StaticResource UrlTextBoxStyle}"
                     Height="36"
                     FontSize="13"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Download folder" />

            <ui:Button Grid.Column="4"
                       Height="36"
                       Content="Browse"
                       Appearance="Secondary"
                       Cursor="Hand"
                       Command="{Binding BrowseOutputFolderCommand}" />

            <ui:Button Grid.Column="6"
                       Width="42"
                       Height="36"
                       Padding="0"
                       Appearance="Secondary"
                       Cursor="Hand"
                       ToolTip="Open folder"
                       Command="{Binding OpenOutputFolderCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE8B7;"
                           FontSize="17" />
            </ui:Button>
        </Grid>

        <ListBox Grid.Row="4"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBoxItem>
                <Border MinHeight="96"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" MinWidth="250" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0"
                                Width="104"
                                Height="74"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}">
                            <Grid>
                                <Image Source="/MediaDownloader.Presentation;component/Images/appIcon.png"
                                       Stretch="UniformToFill"
                                       Opacity="0.92" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,6,5"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#CC111111">
                                    <TextBlock Text="2:53"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE77B;" />
                                <TextBlock Grid.Column="1"
                                           Text="Lorn"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8D6;" />
                                <TextBlock Grid.Column="1"
                                           Text="Acid Rain (Official Music Video)"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FormatBadgeStyle}"
                                             GroupName="FirstItemVideoQuality"
                                             Content="1080p"
                                             IsChecked="True" />
                                <RadioButton Style="{StaticResource FormatBadgeStyle}"
                                             GroupName="FirstItemVideoQuality"
                                             Content="720p" />
                                <RadioButton Style="{StaticResource FormatBadgeStyle}"
                                             GroupName="FirstItemVideoQuality"
                                             Content="480p" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE787;" />
                            <TextBlock Text="17.06.2026"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource MediaModeToggleStyle}"
                                          IsChecked="False"
                                          ToolTip="MP4 / MP3" />
                            <ui:Button Width="36"
                                       Height="36"
                                       Margin="10,0,0,0"
                                       Padding="0"
                                       Appearance="Secondary"
                                       ToolTip="Download"
                                       Cursor="Hand">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE896;"
                                           FontSize="16" />
                            </ui:Button>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="5"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="42"
                                         VerticalAlignment="Center"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                            <TextBlock Grid.Column="1"
                                       Text="42%"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </ListBoxItem>

            <ListBoxItem>
                <Border MinHeight="96"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" MinWidth="250" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0"
                                Width="104"
                                Height="74"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorTertiaryBrush}">
                            <Grid>
                                <Image Source="/MediaDownloader.Presentation;component/Images/appIcon.png"
                                       Stretch="UniformToFill"
                                       Opacity="0.5" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE714;"
                                           FontSize="30"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,6,5"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#CC111111">
                                    <TextBlock Text="3:16"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE77B;" />
                                <TextBlock Grid.Column="1"
                                           Text="Skye Holland"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8D6;" />
                                <TextBlock Grid.Column="1"
                                           Text="We Could Be First Mix"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border HorizontalAlignment="Left"
                                    Style="{StaticResource StaticFormatBadgeStyle}">
                                <TextBlock Text="Best MP3 quality"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE787;" />
                            <TextBlock Text="Not loaded"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource MediaModeToggleStyle}"
                                          IsChecked="True"
                                          ToolTip="MP4 / MP3" />
                            <ui:Button Width="36"
                                       Height="36"
                                       Margin="10,0,0,0"
                                       Padding="0"
                                       Appearance="Secondary"
                                       ToolTip="Download"
                                       Cursor="Hand">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE896;"
                                           FontSize="16" />
                            </ui:Button>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="5"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         VerticalAlignment="Center"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                            <TextBlock Grid.Column="1"
                                       Text="Ready"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </ListBoxItem>
        </ListBox>
    </Grid>
</UserControl>
