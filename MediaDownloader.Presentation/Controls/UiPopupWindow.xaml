<ui:FluentWindow x:Class="MediaDownloader.Presentation.Controls.UiPopupWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440"
                 MinHeight="220"
                 SizeToContent="Height"
                 MaxHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 PreviewKeyDown="WindowPreviewKeyDown">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <Image Width="26"
                       Height="26"
                       HorizontalAlignment="Left"
                        Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Source="{Binding IconPath}"
                       Stretch="Uniform" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding PopupTitle}" />

                <ui:Button Grid.Column="2"
                           ToolTip="{Binding CloseToolTip}"
                           Style="{StaticResource TitleBarImageButtonStyle}"
                           Click="CloseButtonClick">
                    <Image Source="{Binding CloseIconPath}"
                           Width="22"
                           Height="22"
                           Stretch="Uniform" />
                </ui:Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="10"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding Message}" />
                    <CheckBox Margin="0,14,0,0"
                              Content="{Binding CheckBoxText}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Visibility="{Binding CheckBoxVisibility}"
                              IsChecked="{Binding IsCheckBoxChecked, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <ui:Button Width="96"
                               Height="34"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Cursor="Hand"
                               Content="{Binding SecondaryButtonText}"
                               Visibility="{Binding SecondaryButtonVisibility}"
                               IsCancel="True"
                               Click="CancelButtonClick" />
                    <ui:Button Width="96"
                               Height="34"
                               Appearance="Primary"
                               Cursor="Hand"
                               Content="{Binding ButtonText}"
                               IsDefault="True"
                               Click="OkButtonClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
